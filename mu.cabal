data-files:
    messages.dhall
    fileinfo.dhall
data-dir:       resources

source-repository head
  type: git
  location: https://github.com/Futarimiti/mu

executable mu
  main-is: Main.hs
  other-modules:
      Commands
      Config
      Config.Parse
      Config.Parse.Spec
      Config.User
      Downloader
      Editor
      FileInfo
      Global
      Lib
      Messages
      Options
      Play
      Player
      Types
      Update
      Update.Changes
      Update.Manage
      Update.Parse
      Update.Serialisation
      Paths_mu
  hs-source-dirs:
      app
  default-extensions:
      DataKinds
      DeriveGeneric
      DeriveAnyClass
      InstanceSigs
      FlexibleContexts
      StrictData
      ImportQualifiedPost
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -Wmonomorphism-restriction -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , dhall
    , directory
    , exceptions
    , filepath
    , monad-logger
    , mtl
    , optparse-applicative
    , process
    , random-shuffle
    , serialise
    , temporary
    , text
    , transformers >=0.6.0.0 && <0.7
    , yaml
  default-language: Haskell2010
